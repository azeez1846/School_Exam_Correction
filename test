SELECT
  rbd.accountname AS accountname,
  rbd.policy_number AS policy_number,
  rbd.transaction AS transaction,
  rbd.submission_number AS submission_number,
  rbd.effective_date AS effective_date,
  rbd.expiration_date AS expiration_date,
  rbd.termnumber AS termnumber,
  rbd.plob AS plob,
  rbd.base_state AS base_state,
  rbd.underwriting_company AS underwriting_company,
  rbd.underwriter AS underwriter,
  rbd.producer AS producer,
  rbd.policyperiodstatus AS policyperiodstatus,
  rbd.policystatus AS policystatus,
  rbd.industry AS industry,
  rbd.sic2 AS sic2,
  rbd.sic2_desc AS sic2_desc,
  rbd.sic4 AS sic4,
  rbd.sic4_desc AS sic4_desc,
  rbd.naics_code AS naics_code,
  rbd.naics_desc AS naics_desc,
  CASE 
    WHEN rbd.base_state = 'NY' AND COALESCE(rbd.location_count, 1) <= 1 THEN 'Unlimited'
    ELSE rbd.each_accident_limit 
  END AS each_accident_limit,
  CASE 
    WHEN rbd.base_state = 'NY' AND COALESCE(rbd.location_count, 1) <= 1 THEN 'Unlimited'
    ELSE rbd.disease_each_employee_limit 
  END AS disease_each_employee_limit,
  CASE 
    WHEN rbd.base_state = 'NY' AND COALESCE(rbd.location_count, 1) <= 1 THEN 'Unlimited'
    ELSE rbd.disease_policy_limit 
  END AS disease_policy_limit,
  rbd.total_policy_premium AS total_policy_premium,
  rbd.publicid AS publicid,
  rbd.policyperiod_id AS policyperiod_id,
  rbd.updatetime AS updatetime,
  rbd.periodstart AS periodstart,
  rbd.periodend AS periodend
FROM
  (SELECT
    contact.name AS accountname,
    pp.policynumber AS policy_number,
    jobsubtype.name AS transaction,
    job.jobnumber AS submission_number,
    pp.periodstart AS effective_date,
    pp.periodend AS expiration_date,
    pp.termnumber AS termnumber,
    pol.productcode AS plob,
    ppstate.typecode::varchar (2) AS base_state,
    uwcompany.name AS underwriting_company,
    polperuw.uwactualname AS underwriter,
    org.namedenorm AS producer,
    ppstatus.typecode AS policyperiodstatus,
    CASE WHEN ppstatus.typecode != 'Bound' THEN ppstatus.name WHEN pp.cancellationdate IS NOT NULL THEN 'Canceled' WHEN CURRENT_DATE() < pp.periodstart THEN 'Scheduled' WHEN CURRENT_DATE() >= pp.periodend THEN 'Expired' ELSE 'In Force' END AS policystatus,
    indtyp.typecode AS industry,
    acr.sic2code_ext AS sic2,
    acr.sic2desc_ext AS sic2_desc,
    acr.sic4code_ext AS sic4,
    acr.sic4desc_ext AS sic4_desc,
    acr.naicscode_ext AS naics_code,
    acr.naicsdesc_ext AS naics_desc,
    policyline.wcmlineeachaccidentlim::varchar AS each_accident_limit,
    policyline.wcmlinediseaseeachempllim::varchar AS disease_each_employee_limit,
    policyline.wcmlinediseasepolicylim::varchar AS disease_policy_limit,
    COALESCE(polloc_cnt.location_count, 1) AS location_count,
    pp.totalcostrpt AS total_policy_premium,
    pp.id AS policyperiod_id,
    pp.publicid AS publicid,
    pp.updatetime AS updatetime,
    pp.periodstart AS periodstart,
    pp.periodend AS periodend,
    ROW_NUMBER() OVER (PARTITION BY pp.publicid ORDER BY CASE WHEN acr.sic2code_ext IS NOT NULL THEN 1 ELSE 0 END DESC, acr.updatetime DESC) AS row_num
  FROM
    pc10_replication.pc_policyperiod pp
    JOIN pc10_replication.pc_policy pol ON pol.id = pp.policyid AND pol.productcode = 'WCMWorkersComp'
    LEFT JOIN polperuw.polperuw polperuw ON pp.periodid = polperuw.periodid AND pp.branchnumber = polperuw.branchnumber AND pp.jobid = polperuw.jobid
    JOIN pc10_replication.pc_policyline policyline ON policyline.branchid = pp.id
    JOIN pc10_replication.pc_job job ON pp.jobid = job.id
    LEFT JOIN pc10_replication.pctl_policysource_ext polsource ON polsource.id = pol.policysource_ext
    LEFT JOIN pc10_replication.pc_jobpolicyperiod jpp ON pp.id = jpp.ownerid
    JOIN pc10_replication.pctl_job jobsubtype ON job.subtype = jobsubtype.id
    LEFT JOIN pc_acctholderedge_curation.pc_acctholderedge_curation ah ON pol.accountid = ah.ownerid
    LEFT JOIN pc10_replication.pc_acctholderedge ahe ON ahe.id = ah.id
    LEFT JOIN pc10_replication.pc_contact contact ON ahe.foreignentityid = contact.id
    LEFT JOIN pc10_replication.pc_uwcompany uwcompany ON pp.uwcompany = uwcompany.id
    JOIN pc10_replication.pc_account account ON pol.accountid = account.id
    JOIN pc10_replication.pctl_policyperiodstatus ppstatus ON ppstatus.id = pp.status
    LEFT JOIN pc10_replication.pctl_jurisdiction ppState ON pp.basestate = ppstate.id
    JOIN pc10_replication.pc_contact con ON con.id = pp.pnicontactdenorm
    JOIN pc10_replication.pc_accountcontact ac ON ac.contact = con.id
    JOIN pc10_replication.pc_accountcontactrole acr ON acr.accountcontact = ac.id
    LEFT JOIN pc10_replication.pctl_industry_ext indtyp ON indtyp.id = acr.industry_ext
    LEFT JOIN pc10_replication.pc_producercode producercode ON pp.producercodeofrecordid = producercode.id
    LEFT JOIN pc10_replication.pc_organization org ON producercode.organizationid = org.id
    LEFT JOIN pc10_replication.pc_contact orgContact ON orgcontact.id = org.contactid
    LEFT JOIN (
      SELECT 
        pl.branchid,
        COALESCE(
          NULLIF(COUNT(DISTINCT CASE WHEN pl.expirationdate IS NULL THEN pl.locationnum END), 0),
          COUNT(DISTINCT pl.locationnum)
        ) AS location_count
      FROM pc10_replication.pc_policylocation pl
      GROUP BY pl.branchid
    ) polloc_cnt ON polloc_cnt.branchid = pp.id
  ) rbd
WHERE rbd.row_num = 1
ORDER BY rbd.updatetime DESC;
